# .gitignore for AI Customer Support Agent

# Environment
.env
.env.local
*.pem
*.key

# API Keys
OPENAI_API_KEY
HF_TOKEN

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints
*.ipynb

# Data
data/raw/*.csv
data/raw/*.zip
data/processed/
data/*cache*

# Logs
logs/
*.log

# Results (git track sample results, not full runs)
results/evaluation_results.json
results/*.json
results/failure_analysis.md

# Cache
.cache/
*.cache

# Model checkpoints
checkpoints/
models/
